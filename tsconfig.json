{
	"compilerOptions": {
		"module": "esnext",
        "strict": true,
		"target": "es2018",
        "moduleResolution": "node",
		"declaration": true,
        "rootDir": "./src",
		"outDir": "./raw",
        "declarationDir": "./dist/types"
	},
	"include": [
		"src/*"
	],
    "typedocOptions": {
        "entryPoints": ["src/docindex.ts"],
        "out": "docs",
        "excludePrivate": true,
        "excludeProtected": true,
        "categorizeByGroup": false,
        "categoryOrder": ["Chords & Scales", "Clips", "Midi IO", "Timing", "User Inputs", "Other"]
    }
}